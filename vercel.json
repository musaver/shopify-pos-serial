{
  "buildCommand": "npm run setup && npm run build",
  "installCommand": "npm install",
  "framework": null,
  "functions": {
    "build/server/index.js": "@vercel/node"
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/build/server/index.js"
    }
  ]
}
