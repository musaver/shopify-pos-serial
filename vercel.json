{
  "buildCommand": "npm run setup && npm run build",
  "outputDirectory": "build/client",
  "functions": {
    "app/entry.server.tsx": {
      "runtime": "nodejs20.x"
    }
  },
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/build/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/app/entry.server.tsx"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
